public class Solution {
    public int numberOfArithmeticSlices(int[] nums) {
        if (nums == null || nums.length < 3) {
            return 0;
        }
        
        int totalSlices = 0;
        int currentSlices = 0;
        
        // Start from index 2 since we need at least 3 elements
        for (int i = 2; i < nums.length; i++) {
            // Check if the difference between consecutive elements is identical
            if (nums[i] - nums[i - 1] == nums[i - 1] - nums[i - 2]) {
                currentSlices++;
                totalSlices += currentSlices;
            } else {
                // Reset the consecutive slices tracker if the pattern breaks
                currentSlices = 0;
            }
        }
        
        return totalSlices;
    }
}
